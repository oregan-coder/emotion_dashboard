  "target": "T日收盘合格二板候选，T+1收盘是否成为三板；分数不是概率或盈利承诺",
  "weights": {
    "A": 30,
    "B": 40,
    "C": 8,
    "D": 22
  },
  "maximum": 100,
  "method": "透明预算分配+粗粒度分档；未使用样本优化、未宣称行业标准",
  "budget_reallocation": {
    "retained_reference": {
      "A": 25,
      "B": 25,
      "C": 6,
      "D": 22
    },
    "proposed_increment": {
      "A": 5,
      "B": 15,
      "C": 2,
      "D": 0
    },
    "sum_increment": 22,
    "normalized_78_to_100": false
  },
  "items": [
    {
      "rule_id": "A01",
      "module": "A",
      "name": "昨日涨停表现",
      "proposed_weight": 8,
      "previous_draft_weight": 7,
      "formula": "8*clip01((r_pct+3)/8)",
      "inputs": [
        "r_pct"
      ],
      "data_definition": "883900有效数据优先；否则已批准本地有效昨日样本今日涨幅等权平均。",
      "rationale": "昨日强势群体是否得到正反馈；不额外加入另一项赚钱效应固定分。",
      "enabled": false,
      "approval_status": "PENDING_USER_REVIEW"
    },
    {
      "rule_id": "A02",
      "module": "A",
      "name": "已发生二进三承接",
      "proposed_weight": 8,
      "previous_draft_weight": 6,
      "formula": "8*clip01(p23/0.50)",
      "inputs": [
        "p23"
      ],
      "data_definition": "T-1收盘二板有效母体中T日收盘三板的比例。",
      "rationale": "与目标相似但使用已发生的接力结果，不引用T+1标签。",
      "enabled": false,
      "approval_status": "PENDING_USER_REVIEW"
    },
    {
      "rule_id": "A03",
      "module": "A",
      "name": "高位续板保有",
      "proposed_weight": 7,
      "previous_draft_weight": 6,
      "formula": "7*(1-fail_high)",
      "inputs": [
        "fail_high"
      ],
      "data_definition": "昨日≥4板有效母体今日未续板占比；扣除停牌及必要缺数的规则沿用批准稿。",
      "rationale": "将高位群体与全市场炸板统计分开。",
      "enabled": false,
      "approval_status": "PENDING_USER_REVIEW"
    },
    {
      "rule_id": "A04",
      "module": "A",
      "name": "市场封板稳定",
      "proposed_weight": 4,
      "previous_draft_weight": 3,
      "formula": "4*U/(U+Z)",
      "inputs": [
        "U",
        "Z"
      ],
      "data_definition": "U=同范围收盘涨停数；Z=触板后收盘未封数；两者集合互斥。",
      "rationale": "衡量最后封住而非只触板；不混用高位失败率。",
      "enabled": false,
      "approval_status": "PENDING_USER_REVIEW"
    },
    {
      "rule_id": "A05",
      "module": "A",
      "name": "涨跌停两端力量",
      "proposed_weight": 3,
      "previous_draft_weight": 3,
      "formula": "3*U/(U+D)",
      "inputs": [
        "U",
        "D"
      ],
      "data_definition": "U/D=批准范围普通总涨停/总跌停，非真实涨跌停替换。",
      "rationale": "尾部强弱只给低预算，避免与前四项重复放大。",
      "enabled": false,
      "approval_status": "PENDING_USER_REVIEW"
    },
    {
      "rule_id": "B01",
      "module": "B",
      "name": "题材有效成员上涨广度",
      "proposed_weight": 10,
      "previous_draft_weight": 8,
      "formula": "10*breadth",
      "inputs": [
        "breadth"
      ],
      "data_definition": "剔除当前候选后，同日已确认题材有效成员上涨占比，平盘/下跌保留。",
      "rationale": "观察广泛参与，不只看涨停股票。",
      "enabled": false,
      "approval_status": "PENDING_USER_REVIEW"
    },
    {
      "rule_id": "B02",
      "module": "B",
      "name": "题材两日相对强度",
      "proposed_weight": 12,
      "previous_draft_weight": 9,
      "formula": "6*I(excess_median_T>0)+6*I(excess_median_previous>0)",
      "inputs": [
        "excess_median_T",
        "excess_median_previous"
      ],
      "data_definition": "各日题材有效成员中位涨幅减各日同范围市场有效成员中位涨幅。",
      "rationale": "当日和前日均有相对表现才满档；不是五日周期。",
      "enabled": false,
      "approval_status": "PENDING_USER_REVIEW"
    },
    {
      "rule_id": "B03",
      "module": "B",
      "name": "题材梯队规模与层次",
      "proposed_weight": 18,
      "previous_draft_weight": 8,
      "formula": "lower_points(n1)+peer_points(n2)+upper_points(n3plus)+structure_points(n1,n2,n3plus)",
      "inputs": [
        "n1",
        "n2",
        "n3plus"
      ],
      "data_definition": "T日收盘、同一日期化具体交易题材，剔除当前候选后的互斥首板/二板/≥3板有效人数。",
      "rationale": "分别观察新增首板、同高度共同出现、上层支持和多层共存；本项是结构强度，不是主线或龙头认定。",
      "enabled": false,
      "approval_status": "PENDING_USER_REVIEW"
    },
    {
      "rule_id": "C02",
      "module": "C",
      "name": "首板阶段相对先手",
      "proposed_weight": 8,
      "previous_draft_weight": 6,
      "formula": "8*(n-rank)/(n-1) if n>=2 else null",
      "inputs": [
        "n",
        "rank"
      ],
      "data_definition": "T-1同题材全部合格首板的首封时间排名，含当前候选及后来未晋级者；并列平均名次。",
      "rationale": "限制唯一时序指标预算，不拿先封替代业务关联、主线或核心判断。",
      "enabled": false,
      "approval_status": "PENDING_USER_REVIEW"
    },
    {
      "rule_id": "D01",
      "module": "D",
      "name": "最后封板后持续时间",
      "proposed_weight": 10,
      "previous_draft_weight": 10,
      "formula": "10*remaining_session_minutes/240",
      "inputs": [
        "remaining_session_minutes"
      ],
      "data_definition": "T日收盘已确认，最后封板至收盘在09:30-11:30、13:00-15:00计量窗内剩余分钟；09:25映射09:30。",
      "rationale": "表示最终封住后的持续时长；不是预测下午不会开板。",
      "enabled": false,
      "approval_status": "PENDING_USER_REVIEW"
    },
    {
      "rule_id": "D02",
      "module": "D",
      "name": "当日开板次数",
      "proposed_weight": 6,
      "previous_draft_weight": 6,
      "formula": "6/(1+open_break_count)",
      "inputs": [
        "open_break_count"
      ],
      "data_definition": "同一T日完整交易时段的非负整数次数。",
      "rationale": "与D01构成合计16分的稳定组，不再在其他模块按同一开板事实扣分。",
      "enabled": false,
      "approval_status": "PENDING_USER_REVIEW"
    },
    {
      "rule_id": "D03",
      "module": "D",
      "name": "收盘封单相对规模",
      "proposed_weight": 6,
      "previous_draft_weight": 6,
      "formula": "6*clip01(seal_amount/circulating_market_cap/0.01)",
      "inputs": [
        "seal_amount",
        "circulating_market_cap"
      ],
      "data_definition": "同收盘时点、同币种单位的封板资金与流通市值。",
      "rationale": "仅为静态委托规模的代理，不称为订单流、主力净流入或成交保证。",
      "enabled": false,
      "approval_status": "PENDING_USER_REVIEW"
    }
  ],
